generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClinicStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  DOCTOR
  PATIENT
  RECEPTIONIST
  PHARMACIST
  SPECIALIST
  LABORATORY
  NURSING
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  CHECKED_IN
  IN_QUEUE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QueueSessionStatus {
  OPEN
  PAUSED
  CLOSED
}

enum QueuePriority {
  NORMAL
  URGENT
  VIP
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  SKIPPED
  CANCELLED
  NO_SHOW
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSED
  FAILED
}

enum PaymentMethod {
  TELEBIRR
  CBE
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  VERIFIED
  FAILED
  REFUNDED
}

enum DiagnosticType {
  X_RAY
  LAB_TEST
  ULTRASOUND
  ECG
  CT_SCAN
  MRI
}

enum DiagnosticStatus {
  REQUESTED
  IN_PROGRESS
  COMPLETED
  REVIEWED
  CANCELLED
}

enum PrescriptionStatus {
  PENDING
  PAID
  DISPENSED
  CANCELLED
}

model Clinic {
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  email     String
  phone     String
  address   String
  timezone  String       @default("UTC")
  logoUrl   String?      @map("logo_url")
  status    ClinicStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  settings                 ClinicSettings?
  memberships              ClinicMembership[]
  invitations              Invitation[]
  branches                 Branch[]
  doctorProfiles           DoctorProfile[]
  patients                 Patient[]
  services                 Service[]
  doctorServices           DoctorService[]
  doctorSchedules          DoctorSchedule[]
  scheduleExceptions       ScheduleException[]
  appointments             Appointment[]
  appointmentStatusHistory AppointmentStatusHistory[]
  queueSessions            QueueSession[]
  queueCounters            QueueCounter[]
  queueTickets             QueueTicket[]
  queueTicketStatusHistory QueueTicketStatusHistory[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  auditLogs                AuditLog[]
  subscriptions            Subscription[]
  usageRecords             UsageRecord[]
  idempotencyKeys          IdempotencyKey[]
  outboxEvents             OutboxEvent[]
  payments                 Payment[]
  diagnosticOrders         DiagnosticOrder[]
  prescriptions            Prescription[]
  medications              Medication[]

  @@map("clinics")
}

model ClinicSettings {
  id                         String   @id @default(uuid())
  clinicId                   String   @unique @map("clinic_id")
  appointmentDurationDefault Int      @default(30) @map("appointment_duration_default")
  cancellationNoticeHours    Int      @default(24) @map("cancellation_notice_hours")
  maxAdvanceBookingDays      Int      @default(60) @map("max_advance_booking_days")
  queueTokenPrefix           String   @default("T") @map("queue_token_prefix")
  queueAutoCall              Boolean  @default(false) @map("queue_auto_call")
  publicBookingEnabled       Boolean  @default(true) @map("public_booking_enabled")
  smsNotificationsEnabled    Boolean  @default(false) @map("sms_notifications_enabled")
  emailNotificationsEnabled  Boolean  @default(true) @map("email_notifications_enabled")
  telebirrNumber             String   @default("0995774866") @map("telebirr_number")
  telebirrAccountName        String   @default("Metro Health Medical Center") @map("telebirr_account_name")
  cbeAccountNumber           String   @default("1000305532472") @map("cbe_account_number")
  cbeAccountName             String   @default("Metro Health Medical Center") @map("cbe_account_name")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@map("clinic_settings")
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String    @map("password_hash")
  fullName        String    @map("full_name")
  phone           String?
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  memberships             ClinicMembership[]
  refreshTokens           RefreshToken[]
  doctorProfiles          DoctorProfile[]
  patients                Patient[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@map("users")
}

model ClinicMembership {
  id         String           @id @default(uuid())
  clinicId   String           @map("clinic_id")
  userId     String           @map("user_id")
  role       UserRole
  department String?
  status     MembershipStatus @default(ACTIVE)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@index([clinicId, role])
  @@map("clinic_memberships")
}

model Invitation {
  id         String    @id @default(uuid())
  clinicId   String    @map("clinic_id")
  email      String
  role       UserRole
  token      String    @unique
  branchId   String?   @map("branch_id")
  specialty  String?
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdBy  String    @map("created_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  clinic Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([clinicId, email])
  @@map("invitations")
}

model RefreshToken {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  tokenHash       String    @map("token_hash")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  replacedByToken String?   @map("replaced_by_token")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Branch {
  id        String   @id @default(uuid())
  clinicId  String   @map("clinic_id")
  name      String
  address   String
  phone     String
  isMain    Boolean  @default(false) @map("is_main")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorProfiles DoctorProfile[]
  appointments   Appointment[]
  queueSessions  QueueSession[]
  invitations    Invitation[]

  @@index([clinicId, isActive])
  @@map("branches")
}

model DoctorProfile {
  id                         String   @id @default(uuid())
  clinicId                   String   @map("clinic_id")
  userId                     String?  @map("user_id")
  branchId                   String   @map("branch_id")
  fullName                   String   @map("full_name")
  specialty                  String
  licenseNumber              String?  @map("license_number")
  phone                      String
  email                      String
  appointmentDurationMinutes Int      @default(30) @map("appointment_duration_minutes")
  isActive                   Boolean  @default(true) @map("is_active")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  branch             Branch              @relation(fields: [branchId], references: [id], onDelete: Restrict)
  doctorServices     DoctorService[]
  doctorSchedules    DoctorSchedule[]
  scheduleExceptions ScheduleException[]
  appointments          Appointment[]
  queueSessions         QueueSession[]
  referredDiagnostics   DiagnosticOrder[]   @relation("DoctorReferringDiagnostics")
  specialistDiagnostics DiagnosticOrder[]   @relation("SpecialistDiagnostics")
  prescriptions         Prescription[]

  @@index([clinicId, isActive])
  @@index([clinicId, branchId])
  @@map("doctor_profiles")
}

model Patient {
  id               String    @id @default(uuid())
  clinicId         String    @map("clinic_id")
  userId           String?   @map("user_id")
  patientNumber    String    @map("patient_number")
  fullName         String    @map("full_name")
  dateOfBirth      String?   @map("date_of_birth")
  phone            String
  email            String?
  address          String?
  gender           String?
  bloodGroup       String?   @map("blood_group")
  allergies        String?
  emergencyContact String?   @map("emergency_contact")
  consentStatus    Boolean   @default(true) @map("consent_status")
  archivedAt       DateTime? @map("archived_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  clinic                  Clinic                   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  appointments            Appointment[]
  queueTickets            QueueTicket[]
  payments                Payment[]
  diagnosticOrders        DiagnosticOrder[]
  prescriptions           Prescription[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]

  @@unique([clinicId, patientNumber])
  @@index([clinicId, phone])
  @@index([clinicId, fullName])
  @@index([clinicId, userId])
  @@map("patients")
}

model Service {
  id              String   @id @default(uuid())
  clinicId        String   @map("clinic_id")
  name            String
  description     String?
  durationMinutes Int      @default(30) @map("duration_minutes")
  price           Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctorServices DoctorService[]
  appointments   Appointment[]
  queueSessions  QueueSession[]

  @@index([clinicId, isActive])
  @@map("services")
}

model DoctorService {
  id        String @id @default(uuid())
  clinicId  String @map("clinic_id")
  doctorId  String @map("doctor_id")
  serviceId String @map("service_id")

  clinic  Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceId])
  @@index([clinicId, doctorId])
  @@map("doctor_services")
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  clinicId            String   @map("clinic_id")
  doctorId            String   @map("doctor_id")
  dayOfWeek           Int      @map("day_of_week") // 0-6 (0=Sun)
  startTime           String   @map("start_time") // HH:MM
  endTime             String   @map("end_time") // HH:MM
  slotDurationMinutes Int      @default(30) @map("slot_duration_minutes")
  breakStartTime      String?  @map("break_start_time")
  breakEndTime        String?  @map("break_end_time")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model ScheduleException {
  id          String   @id @default(uuid())
  clinicId    String   @map("clinic_id")
  doctorId    String   @map("doctor_id")
  date        String // YYYY-MM-DD
  isAvailable Boolean  @default(false) @map("is_available")
  startTime   String?  @map("start_time")
  endTime     String?  @map("end_time")
  reason      String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  clinic Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, date])
  @@map("schedule_exceptions")
}

model Appointment {
  id                 String            @id @default(uuid())
  clinicId           String            @map("clinic_id")
  branchId           String            @map("branch_id")
  patientId          String            @map("patient_id")
  doctorId           String            @map("doctor_id")
  serviceId          String            @map("service_id")
  appointmentNumber  String            @map("appointment_number")
  scheduledStartAt   DateTime          @map("scheduled_start_at")
  scheduledEndAt     DateTime          @map("scheduled_end_at")
  status             AppointmentStatus @default(CONFIRMED)
  roomNumber         String?           @map("room_number")
  assignedRole       String?           @map("assigned_role")
  reasonForVisit     String?           @map("reason_for_visit")
  internalNotes      String?           @map("internal_notes")
  cancellationReason String?           @map("cancellation_reason")
  createdBy          String            @map("created_by")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  clinic        Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch        Branch                     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  patient       Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile              @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  service       Service                    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  statusHistory AppointmentStatusHistory[]
  queueTicket   QueueTicket?
  payment       Payment?
  diagnosticOrders DiagnosticOrder[]
  prescriptions    Prescription[]

  @@index([clinicId, createdAt])
  @@index([clinicId, scheduledStartAt])
  @@index([clinicId, doctorId, scheduledStartAt])
  @@index([clinicId, patientId])
  @@index([clinicId, status])
  @@map("appointments")
}

model AppointmentStatusHistory {
  id            String             @id @default(uuid())
  clinicId      String             @map("clinic_id")
  appointmentId String             @map("appointment_id")
  fromStatus    AppointmentStatus? @map("from_status")
  toStatus      AppointmentStatus  @map("to_status")
  changedBy     String             @map("changed_by")
  reason        String?
  createdAt     DateTime           @default(now()) @map("created_at")

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([clinicId, appointmentId])
  @@map("appointment_status_history")
}

model QueueSession {
  id            String             @id @default(uuid())
  clinicId      String             @map("clinic_id")
  branchId      String             @map("branch_id")
  doctorId      String?            @map("doctor_id")
  serviceId     String?            @map("service_id")
  operatingDate String             @map("operating_date") // YYYY-MM-DD
  status        QueueSessionStatus @default(OPEN)
  createdAt     DateTime           @default(now()) @map("created_at")
  closedAt      DateTime?          @map("closed_at")

  clinic       Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch       Branch         @relation(fields: [branchId], references: [id], onDelete: Restrict)
  doctor       DoctorProfile? @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  service      Service?       @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  queueCounter QueueCounter?
  queueTickets QueueTicket[]

  @@index([clinicId, operatingDate, status])
  @@index([clinicId, branchId, status])
  @@map("queue_sessions")
}

model QueueCounter {
  id             String   @id @default(uuid())
  clinicId       String   @map("clinic_id")
  queueSessionId String   @unique @map("queue_session_id")
  currentNumber  Int      @default(0) @map("current_number")
  updatedAt      DateTime @updatedAt @map("updated_at")

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueSession QueueSession @relation(fields: [queueSessionId], references: [id], onDelete: Cascade)

  @@map("queue_counters")
}

model QueueTicket {
  id               String        @id @default(uuid())
  clinicId         String        @map("clinic_id")
  queueSessionId   String        @map("queue_session_id")
  patientId        String        @map("patient_id")
  appointmentId    String?       @unique @map("appointment_id")
  tokenNumber      Int           @map("token_number")
  displayToken     String        @map("display_token") // e.g. T-001
  priority         QueuePriority @default(NORMAL)
  status           QueueStatus   @default(WAITING)
  checkedInAt      DateTime      @default(now()) @map("checked_in_at")
  calledAt         DateTime?     @map("called_at")
  serviceStartedAt DateTime?     @map("service_started_at")
  completedAt      DateTime?     @map("completed_at")
  createdBy        String        @map("created_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  clinic        Clinic                     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueSession  QueueSession               @relation(fields: [queueSessionId], references: [id], onDelete: Cascade)
  patient       Patient                    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment   Appointment?               @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  statusHistory QueueTicketStatusHistory[]

  @@unique([queueSessionId, tokenNumber])
  @@index([clinicId, queueSessionId, status])
  @@index([clinicId, patientId])
  @@map("queue_tickets")
}

model QueueTicketStatusHistory {
  id            String       @id @default(uuid())
  clinicId      String       @map("clinic_id")
  queueTicketId String       @map("queue_ticket_id")
  fromStatus    QueueStatus? @map("from_status")
  toStatus      QueueStatus  @map("to_status")
  changedBy     String       @map("changed_by")
  reason        String?
  createdAt     DateTime     @default(now()) @map("created_at")

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  queueTicket QueueTicket @relation(fields: [queueTicketId], references: [id], onDelete: Cascade)

  @@index([clinicId, queueTicketId])
  @@map("queue_ticket_status_history")
}

model Notification {
  id        String             @id @default(uuid())
  clinicId  String             @map("clinic_id")
  userId    String?            @map("user_id")
  patientId String?            @map("patient_id")
  type      NotificationType   @default(IN_APP)
  recipient String
  subject   String
  body      String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?          @map("sent_at")
  createdAt DateTime           @default(now()) @map("created_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([clinicId, status])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(uuid())
  clinicId     String   @map("clinic_id")
  userId       String?  @map("user_id")
  patientId    String?  @map("patient_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  smsEnabled   Boolean  @default(false) @map("sms_enabled")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  clinic  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  patient Patient? @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
  @@unique([clinicId, patientId])
  @@map("notification_preferences")
}

model AuditLog {
  id           String   @id @default(uuid())
  clinicId     String?  @map("clinic_id")
  actorId      String?  @map("actor_id")
  actorRole    String?  @map("actor_role")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, createdAt])
  @@index([clinicId, action])
  @@map("audit_logs")
}

model SubscriptionPlan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  maxDoctors   Int      @default(5) @map("max_doctors")
  maxBranches  Int      @default(1) @map("max_branches")
  maxStaff     Int      @default(10) @map("max_staff")
  priceMonthly Decimal  @default(49.00) @map("price_monthly") @db.Decimal(10, 2)
  features     Json?
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                 String             @id @default(uuid())
  clinicId           String             @map("clinic_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIAL)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  clinic Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  plan   SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([clinicId, status])
  @@map("subscriptions")
}

model UsageRecord {
  id         String   @id @default(uuid())
  clinicId   String   @map("clinic_id")
  metric     String
  count      Int      @default(1)
  recordedAt DateTime @default(now()) @map("recorded_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, metric, recordedAt])
  @@map("usage_records")
}

model IdempotencyKey {
  id        String   @id @default(uuid())
  clinicId  String   @map("clinic_id")
  key       String
  status    String   @default("COMPLETED")
  response  Json?
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  clinicId    String       @map("clinic_id")
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  error       String?
  createdAt   DateTime     @default(now()) @map("created_at")
  processedAt DateTime?    @map("processed_at")

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([status, createdAt])
  @@map("outbox_events")
}

model Payment {
  id             String        @id @default(uuid())
  clinicId       String        @map("clinic_id")
  appointmentId  String        @unique @map("appointment_id")
  patientId      String        @map("patient_id")
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("ETB")
  method         PaymentMethod
  status         PaymentStatus @default(PENDING)
  transactionRef String        @map("transaction_ref")
  payerPhone     String?       @map("payer_phone")
  payerName      String?       @map("payer_name")
  payerAccount   String?       @map("payer_account")
  receiptNumber  String?       @map("receipt_number")
  notes          String?
  verifiedBy     String?       @map("verified_by")
  verifiedAt     DateTime?     @map("verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  clinic      Clinic      @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patient     Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([clinicId, status])
  @@index([clinicId, transactionRef])
  @@map("payments")
}

model DiagnosticOrder {
  id                String           @id @default(uuid())
  clinicId          String           @map("clinic_id")
  appointmentId     String?          @map("appointment_id")
  patientId         String           @map("patient_id")
  referringDoctorId String           @map("referring_doctor_id")
  specialistId      String?          @map("specialist_id")
  type              DiagnosticType   @default(X_RAY)
  title             String
  bodyPart          String?          @map("body_part")
  clinicalNotes     String?          @map("clinical_notes")
  urgency           QueuePriority    @default(NORMAL)
  status            DiagnosticStatus @default(REQUESTED)
  roomNumber        String?          @map("room_number")
  diagnosticDept    String?          @map("diagnostic_dept")

  // Radiology Specialist Findings & Report:
  findings          String?
  impression        String?
  radiologyNotes    String?          @map("radiology_notes")
  imageUrl          String?          @map("image_url")
  completedAt       DateTime?        @map("completed_at")
  completedBy       String?          @map("completed_by")

  // Referring Doctor Review & Final Counseling:
  doctorConclusion  String?          @map("doctor_conclusion")
  reviewedAt        DateTime?        @map("reviewed_at")

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  clinic            Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient           Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointment       Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  referringDoctor   DoctorProfile    @relation("DoctorReferringDiagnostics", fields: [referringDoctorId], references: [id], onDelete: Restrict)
  specialistDoctor  DoctorProfile?   @relation("SpecialistDiagnostics", fields: [specialistId], references: [id], onDelete: SetNull)

  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, referringDoctorId])
  @@map("diagnostic_orders")
}

model Medication {
  id                   String   @id @default(uuid())
  clinicId             String   @map("clinic_id")
  name                 String
  genericName          String?  @map("generic_name")
  category             String   // e.g. Antibiotics, Analgesics, Antihypertensives, Gastrointestinal
  strength             String   // e.g. 500mg, 20mg, 100ml
  dosageForm           String   // e.g. Tablet, Capsule, Syrup, Injection, Ointment
  unitPrice            Decimal  @map("unit_price") @db.Decimal(10, 2) // In ETB (Birr)
  stockQuantity        Int      @default(100) @map("stock_quantity")
  batchNumber          String?  @map("batch_number")
  manufactureDate      DateTime? @map("manufacture_date")
  expiryDate           DateTime? @map("expiry_date")
  hospitalInputDate    DateTime? @default(now()) @map("hospital_input_date")
  requiresPrescription Boolean  @default(true) @map("requires_prescription")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  clinic            Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prescriptionItems PrescriptionItem[]

  @@index([clinicId, name])
  @@index([clinicId, category])
  @@map("medications")
}

model Prescription {
  id                 String             @id @default(uuid())
  clinicId           String             @map("clinic_id")
  patientId          String             @map("patient_id")
  doctorId           String             @map("doctor_id")
  appointmentId      String?            @map("appointment_id")
  prescriptionNumber String             @unique @map("prescription_number")
  diagnosis          String
  status             PrescriptionStatus @default(PENDING)
  notes              String?
  roomNumber         String?            @default("Room 105 - Central Pharmacy") @map("room_number")
  totalAmount        Decimal            @map("total_amount") @db.Decimal(10, 2)
  currency           String             @default("ETB")

  // Pharmacy Payment & Dispensation Fields
  paymentMethod      PaymentMethod?     @map("payment_method")
  paymentStatus      PaymentStatus      @default(PENDING) @map("payment_status")
  paymentRef         String?            @map("payment_ref")
  payerPhone         String?            @map("payer_phone")
  payerName          String?            @map("payer_name")
  payerAccount       String?            @map("payer_account")
  receiptNumber      String?            @map("receipt_number")
  paidAt             DateTime?          @map("paid_at")
  dispensedAt        DateTime?          @map("dispensed_at")
  dispensedBy        String?            @map("dispensed_by")
  dispensationNotes  String?            @map("dispensation_notes")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  clinic      Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor      DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  appointment Appointment?       @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  items       PrescriptionItem[]

  @@index([clinicId, status])
  @@index([clinicId, patientId])
  @@index([clinicId, doctorId])
  @@map("prescriptions")
}

model PrescriptionItem {
  id             String      @id @default(uuid())
  prescriptionId String      @map("prescription_id")
  medicationId   String?     @map("medication_id")
  drugName       String      @map("drug_name")
  dosage         String      // e.g. "500mg" or "1 tablet"
  frequency      String      // e.g. "Three times daily after meals"
  duration       String      // e.g. "5 days"
  quantity       Int         // e.g. 15
  unitPrice      Decimal     @map("unit_price") @db.Decimal(10, 2) // In ETB (Birr)
  totalPrice     Decimal     @map("total_price") @db.Decimal(10, 2) // In ETB (Birr)
  instructions   String?     // e.g. "Take after meals with water"

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   Medication?  @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([prescriptionId])
  @@map("prescription_items")
}
