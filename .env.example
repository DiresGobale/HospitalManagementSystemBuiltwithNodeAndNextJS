# Environment Configuration for CAQMS
NODE_ENV=development
PORT=4000

# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:dg1234@localhost:5432/caqms_db?connection_limit=10&pool_timeout=20

# Redis Connection (Jobs and WebSocket PubSub)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Generate secure 64+ char random keys in production)
JWT_ACCESS_SECRET=super-secure-access-secret-clinic-saas-2026
JWT_REFRESH_SECRET=super-secure-refresh-secret-clinic-saas-2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_DAYS=7

# Frontend Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000

